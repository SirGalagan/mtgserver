seron_kai_convo_template = ConvoTemplate:new {
    initialScreen = "",
    templateType = "Lua",
    luaClassHandler = "seron_kai_convo_handler",
    screens = {}
}

greeting = ConvoScreen:new {
    id = "greeting",
    customDialogText = "I feel a strange presence... who are you?",
    stopConversation = "false",
    options = {
        {"The Force? What do you mean?", "force_intro"},
        {"I'm not interested in fairy tales.", "deny"}
    }
}
seron_kai_convo_template:addScreen(greeting)

force_intro = ConvoScreen:new {
    id = "force_intro",
    customDialogText = "I am Seron Kai. The Force flows through you, untamed. I have long wandered the galaxy seeking those like you...",
    stopConversation = "false",
    options = {
        {"Yes, I'm ready.", "grant_power"},
        {"I'm still not convinced.", "deny"}
    }
}
seron_kai_convo_template:addScreen(force_intro)

grant_power = ConvoScreen:new {
    id = "grant_power",
    customDialogText = "*Seron closes his eyes. A warm light surrounds you...* Take this lightsaber. Seek Master Vantos on Dantooine. He will guide you from here.",
    stopConversation = "true",
    options = {}
}
seron_kai_convo_template:addScreen(grant_power)

deny = ConvoScreen:new {
    id = "deny",
    customDialogText = "Then perhaps you are not ready. The Force waits for no one.",
    stopConversation = "true",
    options = {}
}
seron_kai_convo_template:addScreen(deny)

already_granted = ConvoScreen:new {
    id = "already_granted",
    customDialogText = "We've already spoken. The path is yours now. May the Force be with you.",
    stopConversation = "true",
    options = {}
}
seron_kai_convo_template:addScreen(already_granted)

addConversationTemplate("seron_kai_convo_template", seron_kai_convo_template)

